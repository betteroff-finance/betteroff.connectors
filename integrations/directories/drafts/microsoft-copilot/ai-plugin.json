{
  "$schema": "https://developer.microsoft.com/json-schemas/copilot/plugin/v2.4/schema.json",
  "schema_version": "v2.4",
  "name_for_human": "BetterOff",
  "description_for_human": "Household accounts, spending, net worth, investments, and debt.",
  "contact_email": "zach@betteroff.finance",
  "namespace": "betteroff",
  "logo_url": "https://api.betteroff.finance/.well-known/betteroff-icon.png",
  "legal_info_url": "https://betteroff.finance/legal/terms",
  "privacy_policy_url": "https://betteroff.finance/legal/privacy",
  "runtimes": [
    {
      "type": "RemoteMCPServer",
      "spec": { "url": "https://api.betteroff.finance/mcp" },
      "auth": { "type": "OAuthPluginVault", "reference_id": "${{BETTEROFF_OAUTH_REFERENCE_ID}}" },
      "run_for_functions": ["*"]
    }
  ]
}
